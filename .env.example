# Vault server configuration — copy to .env and adjust as needed.
# The server works without a .env file (defaults + config.json are used).

# ── Debugging ────────────────────────────────────────────────────────────────
# Opt-in debug mode: error responses include stack traces when enabled.
# Off by default — stack traces are never sent to clients unless this is set.
#VAULT_DEBUG=1

# Log verbosity: error | warn | info | debug
#LOG_LEVEL=info

# ── Server ───────────────────────────────────────────────────────────────────
# Port/host are normally set in config.json (run `npm run setup`).
#SERVER_PORT=4000
#SERVER_HOST=0.0.0.0
