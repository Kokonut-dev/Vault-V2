# Dependencies
node_modules/
# Lock-file policy (F-30): npm is the project package manager — the
# package-lock.json IS committed so installs are reproducible across
# machines and CI. Alternative package-manager locks stay ignored.
yarn.lock
pnpm-lock.yaml

# Server runtime data
server/data/
server/cache/
server/media/
server/uploads/
!server/data/.gitkeep
!server/cache/.gitkeep
!server/media/movies/.gitkeep
!server/media/music/.gitkeep
!server/media/videos/.gitkeep
!server/uploads/.gitkeep

# Server config (contains secrets)
server/config.json
server/.env

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build
dist/
build/
.next/
out/

# Env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Misc
.cache/
coverage/
