{
  "name": "vault-server",
  "version": "3.0.0",
  "description": "Vault - Self-hosted personal media server backend",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node launcher.js",
    "dev": "nodemon index.js",
    "setup": "node ../scripts/setup.js",
    "scan": "node -e \"require('./services/scanner').scanAll()\"",
    "generate-cert": "node ../scripts/generate-cert.js",
    "build:css": "node ../scripts/build-css.js",
    "config:example": "node ../scripts/config-example.js",
    "test": "node --test test/*.test.js",
    "test:keyboard": "node ../scripts/keyboard-check.js",
    "test:music": "node ../scripts/music-view-check.js",
    "lint": "node ../scripts/syntax-check.js",
    "check:imports": "node ../scripts/import-check.js",
    "server": "node index.js",
    "launcher": "node launcher.js --no-server"
  },
  "keywords": [
    "media-server",
    "self-hosted",
    "plex",
    "jellyfin",
    "vault"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "music-metadata": "^11.16.1",
    "validator": "^13.11.0"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "jsdom": "^24.1.3",
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "ffmpeg-static": true
  }
}
