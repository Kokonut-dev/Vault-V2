{
  "name": "vault-server",
  "version": "2.0.0",
  "description": "Vault - Self-hosted personal media server backend",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "setup": "node ../scripts/setup.js",
    "scan": "node -e \"require('./services/scanner').scanAll()\""
  },
  "keywords": ["media-server", "self-hosted", "plex", "jellyfin", "vault"],
  "license": "MIT",
  "dependencies": {
