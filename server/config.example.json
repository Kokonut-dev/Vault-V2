{
  "server": {
    "port": 4000,
    "host": "0.0.0.0",
    "mdns": {
      "enabled": false,
      "hostname": "vault"
    },
    "https": {
      "enabled": false,
      "keyPath": "./certs/key.pem",
      "certPath": "./certs/cert.pem"
    }
  },
  "auth": {
    "username": "admin",
    "passwordHash": "will be generated by npm run setup",
    "jwtSecret": "CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING",
    "sessionTimeout": "24h",
    "gridPattern": [
      0,
      1,
      4,
      5,
      8,
      9,
      12,
      13
    ],
    "gridOrderMatters": false,
    "maxAttempts": 5,
    "lockoutDurationMinutes": 15,
    "totp": {
      "enabled": false
    },
    "profiles": {
      "enabled": true,
      "requirePinOnSelect": true
    },
    "subsonic": {
      "enabled": false,
      "username": "admin",
      "passwordEnc": ""
    }
  },
  "media": {
    "paths": {
      "movies": "./media/movies",
      "music": "./media/music",
      "videos": "./media/videos",
      "audiobooks": "./media/audiobooks",
      "podcasts": "./media/podcasts",
      "comics": "./media/comics"
    },
    "libraries": [],
    "ignore": [],
    "scanSchedule": "off",
    "supportedExtensions": {
      "video": [
        ".mp4",
        ".mkv",
        ".webm",
        ".avi",
        ".mov",
        ".wmv",
        ".flv",
        ".m4v",
        ".mpg",
        ".mpeg"
      ],
      "audio": [
        ".mp3",
        ".flac",
        ".wav",
        ".ogg",
        ".opus",
        ".m4a",
        ".aac",
        ".wma",
        ".aiff",
        ".alac"
      ],
      "subtitle": [
        ".srt",
        ".vtt",
        ".ass",
        ".ssa"
      ]
    },
    "maxUploadSizeMB": 10240,
    "storage": "json",
    "thumbnail": {
      "enabled": true,
      "width": 320,
      "height": 180
    },
    "transcoding": {
      "enabled": true,
      "cacheDir": "./cache/transcoded",
      "cacheMaxSizeMB": 5120,
      "videoCodec": "libx264",
      "audioCodec": "aac",
      "hardwareAcceleration": "auto",
      "maxHeight": 1080,
      "segmentSeconds": 6
    },
    "trickplay": {
      "enabled": true,
      "intervalSeconds": 10,
      "width": 160
    },
    "trash": {
      "enabled": true,
      "retentionDays": 30
    },
    "extras": {
      "detectTrailers": true,
      "detectExtras": true,
      "generateChapters": true,
      "detectIntro": true,
      "introMinSeconds": 10,
      "introMaxSeconds": 180
    }
  },
  "metadata": {
    "providers": {
      "musicbrainz": {
        "enabled": false
      },
      "tmdb": {
        "enabled": false,
        "apiKey": ""
      },
      "nfo": {
        "enabled": true
      }
    }
  },
  "podcasts": {
    "autoDownload": false,
    "maxEpisodesPerFeed": 200
  },
  "livetv": {
    "enabled": false,
    "m3uUrl": "",
    "epgUrl": "",
    "hdhrDiscover": false
  },
  "notifications": {
    "webhookUrl": "",
    "ntfyUrl": "",
    "discordWebhook": "",
    "telegram": {
      "botToken": "",
      "chatId": ""
    },
    "scrobble": {
      "lastfm": {
        "apiKey": "",
        "apiSecret": "",
        "sessionKey": ""
      },
      "listenbrainz": {
        "token": ""
      }
    }
  },
  "cors": {
    "origins": [
      "https://kokonut-dev.github.io",
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://localhost:8080",
      "http://localhost:4000"
    ]
  },
  "security": {
    "rateLimit": {
      "general": {
        "windowMs": 900000,
        "max": 200
      },
      "auth": {
        "windowMs": 900000,
        "max": 10
      },
      "upload": {
        "windowMs": 900000,
        "max": 30
      }
    }
  },
  "onboarding": {
    "version": "2.0.0",
    "enablement": true
  }
}
