{
  "server": {
    "port": 4000,
    "host": "0.0.0.0",
    "https": {
      "enabled": false,
      "keyPath": "./certs/key.pem",
      "certPath": "./certs/cert.pem"
    }
  },
  "auth": {
    "username": "admin",
    "passwordHash": "$2a$10$... (will be generated by setup script)",
    "jwtSecret": "CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING",
    "sessionTimeout": "24h",
    "gridPattern": [0, 1, 4, 5, 8, 9, 12, 13],
    "gridOrderMatters": false,
    "maxAttempts": 5,
    "lockoutDurationMinutes": 15
  },
  "media": {
    "paths": {
      "movies": "./media/movies",
      "music": "./media/music",
      "videos": "./media/videos"
    },
    "supportedExtensions": {
      "video": [".mp4", ".mkv", ".webm", ".avi", ".mov", ".wmv", ".flv", ".m4v", ".mpg", ".mpeg"],
      "audio": [".mp3", ".flac", ".wav", ".ogg", ".opus", ".m4a", ".aac", ".wma", ".aiff", ".alac"],
      "subtitle": [".srt", ".vtt", ".ass", ".ssa"]
    },
    "maxUploadSizeMB": 10240,
    "thumbnail": {
      "enabled": true,
      "width": 320,
      "height": 180
    },
    "transcoding": {
      "enabled": true,
      "cacheDir": "./cache/transcoded",
      "cacheMaxSizeMB": 5120,
      "videoCodec": "libx264",
      "audioCodec": "aac"
    }
  },
  "cors": {
    "origins": [
      "https://kokonut-dev.github.io",
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://localhost:8080"
    ]
  },
  "security": {
    "rateLimit": {
      "general": {
        "windowMs": 900000,
        "max": 100
      },
      "auth": {
        "windowMs": 900000,
        "max": 5
      },
      "upload": {
        "windowMs": 900000,
        "max": 20
      }
    }
  }
}
