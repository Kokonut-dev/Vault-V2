+/* Theme transitions */
+* {
+  transition-property: background-color, border-color, color, box-shadow;
+  transition-duration: 0.3s;
+  transition-timing-function: var(--ease-out);
+}
+
+/* Disable transitions for certain elements */
+.no-theme-transition,
+.no-theme-transition * {
+  transition: none !important;
+}
+
+/* Theme-specific overrides */
+
+/* Dark theme enhancements */
+[data-theme="dark"] {
+  color-scheme: dark;
+}
+
+[data-theme="dark"] .media-card {
+  background: linear-gradient(180deg, var(--card-bg) 0%, #151515 100%);
+}
+
+[data-theme="dark"] .player-controls {
+  background: linear-gradient(180deg, rgba(0,0,0,0) 0%, rgba(0,0,0,0.8) 100%);
+}
+
+/* Light theme */
+[data-theme="light"] {
+  color-scheme: light;
+}
+
+[data-theme="light"] .media-card {
+  border: 1px solid var(--border);
+}
+
+[data-theme="light"] .sidebar {
+  border-right: 1px solid var(--border);
+}
+
+/* Warm theme */
+[data-theme="warm"] {
+  color-scheme: light;
+}
+
+[data-theme="warm"] .media-card {
+  background: var(--card-bg);
+  border: 1px solid var(--border);
+  box-shadow: 0 2px 8px rgba(61,43,31,0.06);
+}
+
+[data-theme="warm"] .btn-primary {
+  background: linear-gradient(135deg, var(--accent) 0%, #B45309 100%);
+}
+
+/* Cold theme */
+[data-theme="cold"] {
+  color-scheme: dark;
+}
+
+[data-theme="cold"] .media-card {
+  background: linear-gradient(180deg, var(--card-bg) 0%, #162032 100%);
+  border: 1px solid rgba(34,211,238,0.1);
+}
+
+[data-theme="cold"] .accent-glow {
+  box-shadow: 0 0 20px rgba(34,211,238,0.3);
+}
+
+/* Theme switch animation */
+.theme-transition {
+  animation: themeFade 0.4s var(--ease-out);
+}
+
+@keyframes themeFade {
+  0% { opacity: 0.8; }
+  100% { opacity: 1; }
+}
+
+/* Ensure all themed elements use variables */
+.btn, .card, .modal, .sidebar, .player, .search-modal, .toast {
+  background-color: var(--bg-elevated);
+  color: var(--text-primary);
+  border-color: var(--border);
+}
