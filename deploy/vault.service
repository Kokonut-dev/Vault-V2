[Unit]
# Vault media server — systemd unit (Linux). See deploy/README.md.
Description=Vault media server
Documentation=https://github.com/Kokonut-dev/Vault-V2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User/WorkingDirectory to match your install location.
User=vault
Group=vault
WorkingDirectory=/opt/vault/server
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=5
# Exit 78 = configuration error (e.g. the port is already in use) — restarting
# every 5 seconds won't fix it, so stop and let `journalctl -u vault` explain.
RestartPreventExitStatus=78
# Uncomment to enable Settings → Connection → Restart in the app (exit 75 is
# treated as a failure, so systemd restarts it). Stop from the app exits 0 and
# stays stopped until `systemctl start vault`.
#Environment=VAULT_SUPERVISED=1

# Environment (uncomment to override config.json)
#Environment=VAULT_PORT=4000
#Environment=LOG_LEVEL=info
#Environment=VAULT_MDNS=1

# Hardening — the server only needs to read media and write its own data dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/vault/server/data /opt/vault/server/cache /opt/vault/server/logs

[Install]
WantedBy=multi-user.target
